# Compose-only public access overrides. Keep the loopback defaults for one-computer use.
# For a trusted local network, replace the addresses with this computer's LAN address and set
# OPENROUND_STORAGE_BIND=0.0.0.0 only when other devices must load question images directly.
OPENROUND_PUBLIC_URL=http://localhost:8080
OPENROUND_API_URL=
OPENROUND_HTTP_BIND=0.0.0.0
OPENROUND_STORAGE_URL=http://localhost:9000
OPENROUND_STORAGE_BIND=127.0.0.1

# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
WEB_ORIGIN=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
COOKIE_NAME=openround_creator
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Development/trusted-LAN escape hatch. Production accepts this only for non-billing community
# deployments whose public URLs resolve to loopback or private-network addresses.
ALLOW_INSECURE_LOCAL_HTTP=false
LOG_LEVEL=info
ALLOW_IN_MEMORY=false
COMMUNITY_MODE=true
MAX_SESSION_PARTICIPANTS=100
MAX_PRACTICE_PERSONAL_LINKS=100
RETENTION_INTERVAL_MINUTES=60
COMMUNITY_REPORT_RETENTION_DAYS=365
MEDIA_QUARANTINE_RETENTION_HOURS=24
FEATURE_SIGNUPS=true
FEATURE_SESSION_CREATION=true
FEATURE_MEDIA_UPLOADS=true
FEATURE_ROUND_EXPERIENCES=true
FEATURE_AUDIENCE_PULSE=true
FEATURE_ROOM_CHAT=true
FEATURE_UX_BETA=false
FEATURE_RECOVERY_REHEARSAL=false
FEATURE_PRACTICE_ASSIGNMENTS=false
# Independent rollback switches for the professional workspace milestones. All default off. These
# are deployment ceilings; FEATURE_UX_BETA plus UX_BETA_WORKSPACE_ALLOWLIST membership is also
# required for a workspace to receive them.
FEATURE_WORKSPACE_SHELL=false
FEATURE_BUILDER_V2=false
FEATURE_PRESENTATIONS=false
FEATURE_GROUPS=false
FEATURE_DISCOVER=false
# Evidence-gated roadmap capabilities. A flag alone is insufficient; the workspace UUID must also
# be present in EVIDENCE_FEATURES_WORKSPACE_ALLOWLIST.
FEATURE_PRESENTATION_REALTIME=false
FEATURE_PRESENTATION_COMPANION=false
FEATURE_LIVE_FLEX_MODE=false
# Enable only after every serving binary includes the commit-visible Presentation snapshot fence.
# Disable before rolling back to an earlier image.
PRESENTATION_CONCURRENT_RESPONSE_WRITES=false
FEATURE_RECOVERY_PACKS=false
# Live playback also requires Pack authoring and the evidence workspace allowlist. Keep this off
# during mixed-version deployment; enable only after all v5-only server/worker writers are drained.
FEATURE_RECOVERY_PACK_LIVE_CARDS=false
FEATURE_QUESTION_HEALTH=false
FEATURE_DECISION_REPLAY=false
FEATURE_RECOVERY_TRAILS=false
FEATURE_CONCEPT_HEALTH=false
FEATURE_EXTENDED_QUESTION_TYPES=false
FEATURE_VERIFIED_INSTITUTION=false
# Core-parity writers are independently staged and require the dedicated allowlist below.
# Presentation Q&A and poll/rating self-paced Surveys are implemented beta slices.
# Feedback-room live polls/Q&A, new opinion formats and exports remain pending.
FEATURE_AUDIENCE_SCOPES=false
FEATURE_FEEDBACK_ROOMS=false
FEATURE_SURVEYS=false
FEATURE_FEEDBACK_EXPORTS=false
CORE_PARITY_WORKSPACE_ALLOWLIST=
# Optional comma-separated workspace UUIDs. Empty enables themed interactions for every workspace.
THEMED_INTERACTIONS_WORKSPACE_ALLOWLIST=
# Comma-separated pilot workspace UUIDs. Empty disables the UX beta for every workspace.
UX_BETA_WORKSPACE_ALLOWLIST=
EVIDENCE_FEATURES_WORKSPACE_ALLOWLIST=
METRICS_ENABLED=true
METRICS_TOKEN=
# Optional loopback-only Compose observability profile. Change the Grafana password before sharing
# access; do not expose either port directly to the internet.
OPENROUND_PROMETHEUS_PORT=9090
OPENROUND_PROMETHEUS_RETENTION=15d
OPENROUND_GRAFANA_PORT=3001
OPENROUND_GRAFANA_USER=admin
OPENROUND_GRAFANA_PASSWORD=openround-local-change-me
TRACING_ENABLED=false
# Full OTLP/HTTP trace endpoint, normally ending in /v1/traces.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=openround-server
OTEL_SERVICE_VERSION=0.1.0
# Local build marker. Release images bake this into /app/BUILD_ID; runtime environment overrides
# cannot replace the marker embedded in the server image.
OPENROUND_BUILD_ID=unversioned
RUN_MIGRATIONS=true

# Optional source-grounded authoring assistant. It is disabled by default and accepts only an
# operator-approved OpenAI-compatible chat-completions endpoint. Community operators bring their
# own provider and remain responsible for its privacy, residency, security, cost, and model terms.
AUTHORING_AI_MODE=disabled
AUTHORING_AI_ENDPOINT=
AUTHORING_AI_API_KEY=
AUTHORING_AI_MODEL=operator-configured
AUTHORING_AI_PROVIDER_NAME=operator
AUTHORING_WORKER_INTERVAL_MS=3000
AUTHORING_WORKER_LEASE_MS=120000
AUTHORING_EXTRACTION_TIMEOUT_MS=20000

# Optional generic OIDC for creator accounts. Institution policy must also be granted by an
# operator before a workspace can use this provider. Existing creators explicitly link the
# external identity first; Polling Pops never links an unknown identity by matching email.
OIDC_MODE=disabled
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_AUTH=client_secret_post
OIDC_PROVIDER_NAME=Institution sign-in
OIDC_TRANSACTION_TTL_SECONDS=300

# Optional contract-gated LTI 1.3 tool support. Store an RSA signing key as a private JWK in the
# deployment secret manager; never commit a real key. Registrations are created through the
# administrator API and each workspace must also have the LTI capability granted.
LTI_MODE=disabled
LTI_TOOL_PRIVATE_JWK=
LTI_TOOL_KEY_ID=openround-lti-1
LTI_TRANSACTION_TTL_SECONDS=300
LTI_LAUNCH_TTL_SECONDS=900
AUDIT_RETENTION_DAYS=365

# Durable and ephemeral data
DATABASE_URL=postgresql://openround:openround-local@postgres:5432/openround
# Optional privileged connection used only while applying migrations. In production,
# keep DATABASE_URL on a non-owner role subject to row-level security.
DATABASE_MIGRATION_URL=
REDIS_URL=redis://valkey:6379
# Per-session distributed mutation ownership. Keep the wait shorter than the TTL.
SESSION_MUTATION_LEASE_TTL_MS=15000
SESSION_MUTATION_LEASE_WAIT_MS=5000

# Email. Mailpit captures local messages at http://localhost:8025
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=Polling Pops <noreply@openround.local>
# Optional browser-facing inbox used only to guide Community users to captured development email.
DEVELOPMENT_EMAIL_INBOX_URL=http://localhost:8025
# Disabled by default. A returned link is a bearer credential that bypasses inbox verification.
# Enable only for isolated local testing while OPENROUND_HTTP_BIND is restricted to 127.0.0.1.
AUTH_DEBUG_MAGIC_LINKS=false
# Replace with the counsel-approved terms/privacy release identifier.
POLICY_VERSION=2026-09-14-draft

# S3-compatible media storage
S3_ENDPOINT=http://minio:9000
# Browser-reachable endpoint used only when signing direct uploads and downloads.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ca-central-1
S3_BUCKET=openround-media
S3_ACCESS_KEY_ID=openround
S3_SECRET_ACCESS_KEY=change-this-local-secret
S3_FORCE_PATH_STYLE=true
MEDIA_SCAN_MODE=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Hosted billing. Keep disabled for community deployments.
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Set a random value of at least 24 characters before enabling admin routes.
ADMIN_TOKEN=replace-with-a-random-admin-token
