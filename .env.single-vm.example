# Copy this file outside source control, restrict it to the deployment user (chmod 600), and
# replace every `replace-*` value. Passwords used inside connection URLs must be URL encoded.

# Public DNS. Point both names at the VM before starting Caddy so it can issue certificates.
# OPENROUND_SERVER_IMAGE, OPENROUND_WEB_IMAGE, and OPENROUND_BUILD_ID are release-owned values.
# The deployment automation injects them from the verified build manifest; do not add them here.
OPENROUND_DEPLOYMENT_ENVIRONMENT=replace-with-staging-or-production
OPENROUND_APP_DOMAIN=app.example.com
OPENROUND_MEDIA_DOMAIN=media.example.com
OPENROUND_ACME_EMAIL=ops@example.com

# Private Caddy-to-API network. Change both values together only if this subnet conflicts with a
# host route; the proxy IP must remain inside the subnet and must not be assigned to another service.
OPENROUND_SERVER_INGRESS_SUBNET=172.30.255.0/29
OPENROUND_CADDY_PROXY_IP=172.30.255.2

# PostgreSQL. Keep the owner credential out of the application container. DATABASE_MIGRATION_URL
# belongs in a separate, short-lived migration env file and is intentionally omitted here.
POSTGRES_DB=openround
POSTGRES_OWNER_USER=openround_owner
POSTGRES_OWNER_PASSWORD=replace-owner-password-with-url-safe-random-value
POSTGRES_APP_USER=openround_app
POSTGRES_APP_PASSWORD=replace-app-password-with-url-safe-random-value
DATABASE_URL=postgresql://openround_app:replace-app-password-with-url-safe-random-value@postgres:5432/openround

# Valkey. REDIS_URL must contain the URL-encoded form of the same password.
VALKEY_PASSWORD=replace-valkey-password-with-url-safe-random-value
REDIS_URL=redis://:replace-valkey-password-with-url-safe-random-value@valkey:6379

# Private MinIO root identity and bucket-scoped application identity.
MINIO_ROOT_USER=openround-root
MINIO_ROOT_PASSWORD=replace-minio-root-password
MINIO_APP_ACCESS_KEY=openround-app
MINIO_APP_SECRET_KEY=replace-minio-app-secret
MINIO_BUCKET=openround-media
S3_REGION=us-east-1

# SMTP is required while hosted sign-ups are enabled.
SMTP_URL=smtps://replace-user:replace-password@smtp.example.com:465
EMAIL_FROM=OpenRound <noreply@example.com>

# Security and operational controls.
ADMIN_TOKEN=replace-with-at-least-24-random-characters
METRICS_TOKEN=replace-with-at-least-24-random-characters
METRICS_ENABLED=true
# The Compose overlay intentionally does not read Docker logs. A separately managed host agent
# must ship the server's structured stdout logs to the backend queried by the readiness observer.
OPENROUND_LOG_SHIPPING_MODE=external-host-agent
POLICY_VERSION=replace-with-released-policy-version
LOG_LEVEL=info
MAX_SESSION_PARTICIPANTS=100
MAX_PRACTICE_PERSONAL_LINKS=100
COMMUNITY_MODE=false
BILLING_MODE=disabled

# Core feature switches.
FEATURE_SIGNUPS=true
FEATURE_SESSION_CREATION=true
FEATURE_MEDIA_UPLOADS=true
FEATURE_ROUND_EXPERIENCES=true
FEATURE_AUDIENCE_PULSE=true
FEATURE_ROOM_CHAT=true

# Professional workspace rollout. Keep the beta off until its workspace UUID is allowlisted.
FEATURE_UX_BETA=false
FEATURE_RECOVERY_REHEARSAL=false
FEATURE_PRACTICE_ASSIGNMENTS=false
FEATURE_WORKSPACE_SHELL=false
FEATURE_BUILDER_V2=false
FEATURE_PRESENTATIONS=false
FEATURE_GROUPS=false
FEATURE_DISCOVER=false
FEATURE_PRESENTATION_REALTIME=false
FEATURE_PRESENTATION_COMPANION=false
# Enable only after the realtime-capable image is the sole serving version. Disable before rollback.
PRESENTATION_CONCURRENT_RESPONSE_WRITES=false
FEATURE_RECOVERY_PACKS=false
FEATURE_QUESTION_HEALTH=false
FEATURE_DECISION_REPLAY=false
FEATURE_RECOVERY_TRAILS=false
FEATURE_CONCEPT_HEALTH=false
FEATURE_EXTENDED_QUESTION_TYPES=false
FEATURE_VERIFIED_INSTITUTION=false
# Staged core-parity writers. Scope activation is metadata-only in the current increment.
FEATURE_AUDIENCE_SCOPES=false
FEATURE_FEEDBACK_ROOMS=false
FEATURE_SURVEYS=false
FEATURE_FEEDBACK_EXPORTS=false
CORE_PARITY_WORKSPACE_ALLOWLIST=
THEMED_INTERACTIONS_WORKSPACE_ALLOWLIST=
UX_BETA_WORKSPACE_ALLOWLIST=
EVIDENCE_FEATURES_WORKSPACE_ALLOWLIST=

# Optional integrations.
AUTHORING_AI_MODE=disabled
AUTHORING_AI_ENDPOINT=
AUTHORING_AI_API_KEY=
AUTHORING_AI_MODEL=operator-configured
AUTHORING_AI_PROVIDER_NAME=operator
OIDC_MODE=disabled
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_AUTH=client_secret_post
OIDC_PROVIDER_NAME=Institution sign-in
LTI_MODE=disabled
LTI_TOOL_PRIVATE_JWK=
LTI_TOOL_KEY_ID=openround-lti-1
# The hosted overlay keeps application telemetry private, then exports metrics and traces to the
# explicitly selected authenticated backend. The application sends traces only to the internal
# collector. Receiver URLs and the backend token are secrets; never commit their resolved values.
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OPENROUND_OTLP_BACKEND_ENDPOINT=replace-with-reviewed-https-otlp-endpoint
OPENROUND_OTLP_BACKEND_TOKEN=replace-with-reviewed-backend-token
OPENROUND_PAGING_WEBHOOK_URL=replace-with-secret-https-page-receiver-url
OPENROUND_WARNING_WEBHOOK_URL=replace-with-secret-https-warning-receiver-url
OPENROUND_TICKET_WEBHOOK_URL=replace-with-secret-https-ticket-receiver-url
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional business overlay. Add compose.single-vm.business.yaml and its two Caddy files to the
# reviewed deployment target; product-build then builds/scans/signs the separate control image.
# OPENROUND_CONTROL_IMAGE is release-owned and must not be included in this runtime env file.
BUSINESS_PLATFORM_ENABLED=false
BUSINESS_EVENT_CREDITS_ENABLED=false
BUSINESS_CATALOG_JSON=[]
BUSINESS_STRIPE_AUTOMATIC_TAX_ENABLED=false
CONTROL_DOMAIN=control.example.com
# Defaults to the configured OPENROUND_APP_DOMAIN in the hosted business overlay.
CONTROL_PRODUCT_ORIGIN=
CONTROL_ALLOWED_CIDRS=replace-with-reviewed-operator-network-cidrs
CONTROL_DATABASE_URL=postgresql://openround_control:replace-control-password-with-url-safe-random-value@postgres:5432/openround
OPERATOR_OIDC_ISSUER=
OPERATOR_OIDC_CLIENT_ID=
OPERATOR_OIDC_CLIENT_SECRET=
OPERATOR_OIDC_REQUIRED_AMR=
OPERATOR_OIDC_ALLOWED_ACR=
OPERATOR_BOOTSTRAP_IDENTITIES=[]
INTEGRATION_SECRET_KEY=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_PRODUCTION_READS_ENABLED=false

# Initial 4-vCPU / 8-GB single-VM limits. Tune only after measuring the target host.
OPENROUND_POSTGRES_CPUS=1.5
OPENROUND_POSTGRES_MEMORY_LIMIT=1280m
OPENROUND_VALKEY_CPUS=0.5
OPENROUND_VALKEY_MEMORY_LIMIT=512m
OPENROUND_MINIO_CPUS=1.0
OPENROUND_MINIO_MEMORY_LIMIT=768m
OPENROUND_CLAMAV_CPUS=1.25
OPENROUND_CLAMAV_MEMORY_LIMIT=1536m
OPENROUND_SERVER_CPUS=2.0
OPENROUND_SERVER_MEMORY_LIMIT=1536m
OPENROUND_WEB_CPUS=1.0
OPENROUND_WEB_MEMORY_LIMIT=640m
OPENROUND_CADDY_CPUS=0.5
OPENROUND_CADDY_MEMORY_LIMIT=256m
OPENROUND_OTEL_CPUS=0.5
OPENROUND_OTEL_MEMORY_LIMIT=512m
OPENROUND_PROMETHEUS_CPUS=0.5
OPENROUND_PROMETHEUS_MEMORY_LIMIT=768m
OPENROUND_ALERTMANAGER_CPUS=0.25
OPENROUND_ALERTMANAGER_MEMORY_LIMIT=256m
