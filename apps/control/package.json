{
  "name": "@openround/control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3002",
    "build": "node ../../scripts/build/next.mjs control",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "lint": "eslint app lib test next.config.ts proxy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build:admin": "cd ../.. && tsup --config tsup.admin.config.ts && node apps/control/admin-dist/admin-cli.mjs --help"
  },
  "dependencies": {
    "@openround/contracts": "workspace:*",
    "@openround/control-plane": "workspace:*",
    "@openround/db": "workspace:*",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
