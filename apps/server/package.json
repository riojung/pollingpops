{
  "name": "@openround/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "config:check": "node dist/config-check.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src test",
    "start": "node dist/index.js",
    "start:jobs": "node dist/jobs.js",
    "test": "vitest run",
    "test:multi-writer": "vitest run test/multi-writer.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/formbody": "9.0.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/otel": "0.21.2",
    "@fastify/rate-limit": "11.2.1",
    "@openround/contracts": "workspace:*",
    "@openround/control-plane": "workspace:*",
    "@openround/db": "workspace:*",
    "@openround/experience": "workspace:*",
    "@openround/game-engine": "workspace:*",
    "@openround/insights": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@prometheus-io/client": "0.16.1",
    "@socket.io/redis-streams-adapter": "0.3.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "5.12.5",
    "fastify-raw-body": "6.0.2",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.1.0",
    "openid-client": "6.8.8",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sanitize-html": "2.18.0",
    "socket.io": "4.8.4",
    "stripe": "22.6.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "@types/sanitize-html": "2.16.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "pino-pretty": "13.1.3"
  }
}
