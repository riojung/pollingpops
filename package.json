{
  "name": "polling-pops-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Polling Pops interactive learning and audience participation workspace",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "1.14.5",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "fast-uri@>=4.0.0 <4.1.5": "4.1.5",
      "ip-address@>=10.0.0 <10.7.1": "10.7.2",
      "sharp@>=0.35.4 <0.35.5": "0.35.5",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "tsup>esbuild": "0.28.1"
    }
  },
  "scripts": {
    "admin:setup": "node scripts/ops/admin-setup.mjs",
    "admin:build": "tsup --config tsup.admin.config.ts && node apps/control/admin-dist/admin-cli.mjs --help",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "build": "turbo run build && pnpm admin:build",
    "alerts:rehearse": "node scripts/rehearse-alerts.mjs",
    "check:docker-context": "node scripts/check-docker-workspace-deps.mjs",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guides:capture": "playwright test --config=playwright.guides.config.ts",
    "guides:render": "tsx scripts/demo/render-polling-pops-guides.ts",
    "licenses:report": "node scripts/generate-third-party-notices.mjs",
    "lint": "turbo run lint",
    "load:compose:aggregate": "tsx tests/load/compose-aggregate-load.ts",
    "load:compose": "tsx tests/load/compose-game-load.ts",
    "load:presentation": "tsx tests/load/presentation-load.ts",
    "load:presentation:compose": "tsx tests/load/compose-presentation-load.ts",
    "load:socket": "tsx tests/load/socket-load.ts",
    "network:urls": "node scripts/show-network-urls.mjs",
    "local:start": "node scripts/ops/local-start.mjs",
    "product:build": "bash scripts/product-build.sh",
    "service": "bash scripts/service.sh",
    "deploy": "bash scripts/deploy.sh",
    "evidence:backup-restore:check": "node scripts/check-backup-restore-evidence.mjs",
    "evidence:target-load": "node scripts/ops/target-load-evidence.mjs",
    "readiness:check": "node scripts/check-release-readiness.mjs",
    "readiness:require:beta": "node scripts/check-release-readiness.mjs --require=single-vm-beta",
    "readiness:require:beta:preflight": "node scripts/check-release-readiness.mjs --require=single-vm-beta-preflight",
    "research:check": "node scripts/check-phase0-research.mjs",
    "smoke:compose": "tsx tests/smoke/compose.ts",
    "smoke:minio-volume-upgrade": "bash scripts/smoke-minio-volume-upgrade.sh",
    "smoke:multi-process": "tsx tests/smoke/multi-process.ts",
    "smoke:observability": "tsx tests/smoke/observability.ts",
    "smoke:restore": "tsx tests/smoke/backup-restore.ts",
    "smoke:remote": "tsx tests/smoke/remote-readiness.ts",
    "smoke:stripe-replay": "tsx tests/smoke/stripe-replay.ts",
    "smoke:tracing": "pnpm --filter @openround/server build && tsx tests/smoke/tracing.ts",
    "test": "turbo run test && pnpm test:smoke-support",
    "test:alerts": "docker run --rm --volume \"$PWD/infra/observability:/etc/prometheus:ro\" --entrypoint /bin/promtool prom/prometheus:v3.5.0 test rules /etc/prometheus/alerts.test.yml",
    "test:alert-routing": "node scripts/check-alert-routes.mjs",
    "test:collector-config": "node scripts/check-collector-config.mjs",
    "test:multi-writer": "pnpm --filter @openround/server test:multi-writer",
    "test:smoke-support": "vitest run tests/support",
    "test:e2e": "playwright test",
    "test:e2e:beta": "playwright test --config=playwright.beta.config.ts",
    "test:e2e:business": "playwright test --config=playwright.business.config.ts",
    "test:e2e:canvas": "playwright test --config=playwright.canvas.config.ts",
    "test:e2e:control": "playwright test --config=playwright.control.config.ts",
    "test:e2e:local-admin": "playwright test --config=playwright.local-admin.config.ts",
    "test:e2e:compose": "playwright test --config=playwright.compose.config.ts",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm check:docker-context && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "prettier": "3.9.6",
    "socket.io-client": "4.8.4",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
