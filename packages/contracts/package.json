{
  "name": "@openround/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./surveys": {
      "types": "./src/surveys.ts",
      "import": "./src/surveys.ts"
    }
