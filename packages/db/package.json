{
  "name": "@openround/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "eslint src test",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:postgres": "vitest run test/postgres.test.ts test/platform-conformance.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openround/contracts": "workspace:*",
    "@openround/game-engine": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
