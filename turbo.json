{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!test-utils/**",
        "!**/*.test.*",
        "!.next*/**",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!test-utils/**",
        "!**/*.test.*",
        "!.next*/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/build/**"
      ],
      "outputs": ["dist/**"]
    },
    "@openround/web#build": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!test-utils/**",
        "!**/*.test.*",
        "!.next*/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/build/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "OPENROUND_BUILD_ID",
        "OPENROUND_NEXT_DIST_DIR",
        "PLAYWRIGHT_BUSINESS",
        "PLAYWRIGHT_CONTROL",
        "CANVAS_COLLAB_DIST_DIR"
      ],
      "outputs": [],
      "passThroughEnv": ["OPENROUND_BUILD_TIMEOUT_MS", "OPENROUND_BUILD_HEARTBEAT_MS"],
      "cache": false,
      "description": "Always enter the guarded Next compiler; artifact restoration would bypass output locks and variant validation."
    },
    "@openround/control#build": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!test-utils/**",
        "!**/*.test.*",
        "!.next*/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/build/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "OPENROUND_BUILD_ID",
        "OPENROUND_NEXT_DIST_DIR",
        "PLAYWRIGHT_BUSINESS",
        "PLAYWRIGHT_CONTROL",
        "CANVAS_COLLAB_DIST_DIR"
      ],
      "outputs": [],
      "passThroughEnv": ["OPENROUND_BUILD_TIMEOUT_MS", "OPENROUND_BUILD_HEARTBEAT_MS"],
      "cache": false,
      "description": "Always enter the guarded Next compiler; artifact restoration would bypass output locks and variant validation."
    },
    "build:admin": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!test-utils/**",
        "!**/*.test.*",
        "!.next*/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsup.admin.config.ts"
      ],
      "outputs": ["admin-dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/build/*.d.mts"
      ]
    },
    "test": {
      "dependsOn": ["^transit"],
      "env": ["VITEST_MAX_WORKERS", "OPENROUND_BUILD_ID"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "test:coverage": {
      "dependsOn": ["^transit"],
      "env": ["VITEST_MAX_WORKERS", "OPENROUND_BUILD_ID"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "@openround/db#test": {
      "dependsOn": ["^transit"],
      "env": ["VITEST_MAX_WORKERS", "OPENROUND_BUILD_ID"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_ADMIN_URL",
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL",
        "IDEA_BOARD_PIPELINE_*"
      ]
    },
    "@openround/db#test:coverage": {
      "dependsOn": ["^transit"],
      "env": ["VITEST_MAX_WORKERS", "OPENROUND_BUILD_ID"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_ADMIN_URL",
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL",
        "IDEA_BOARD_PIPELINE_*"
      ]
    },
    "@openround/server#test": {
      "dependsOn": ["^transit"],
      "env": ["VITEST_MAX_WORKERS", "OPENROUND_BUILD_ID"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_ADMIN_URL",
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL",
        "IDEA_BOARD_PIPELINE_*"
      ]
    },
    "@openround/server#test:coverage": {
      "dependsOn": ["^transit"],
      "env": ["VITEST_MAX_WORKERS", "OPENROUND_BUILD_ID"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_ADMIN_URL",
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL",
        "IDEA_BOARD_PIPELINE_*"
      ]
    }
  }
}
